# Docker Compose configuration for the full local Opencom stack (self-hosted Convex).
# Copy to `.env` (which docker compose loads automatically) and fill in values:
#
#   cp .env.docker.example .env
#
# `.env` is gitignored — do not commit real secrets.

# REQUIRED. 32-byte hex secret that seeds the self-hosted Convex instance and the derived
# admin key. Generate one with: openssl rand -hex 32
# Keep it stable — changing it invalidates the admin key and existing data.
CONVEX_INSTANCE_SECRET=

# OPTIONAL. Pin the Convex backend/dashboard image tags. Defaults to `latest`.
# The backend must be compatible with the pinned convex CLI (package.json -> convex 1.35.1).
# If `convex deploy` fails with a version error, pin a specific tag here (see
# https://github.com/get-convex/convex-backend/pkgs/container/convex-backend).
# CONVEX_BACKEND_TAG=latest
# CONVEX_DASHBOARD_TAG=latest

# OPTIONAL. Default workspace ID used by the web widget-demo, landing demo, and widget
# dev bootstrap. Leave blank on first run; after you sign up at http://localhost:3000 and
# create a workspace, paste its ID here and `docker compose up -d web landing widget`.
OPENCOM_WORKSPACE_ID=

# OPTIONAL integration secrets. When set, they are pushed to the Convex deployment during
# the one-shot deploy step (only if not already set on the deployment).
# Email (OTP sign-in + email channel):
# RESEND_API_KEY=
# AUTH_RESEND_KEY=
# EMAIL_FROM=YourCompany <noreply@yourdomain.com>
# RESEND_WEBHOOK_SECRET=
# Aya AI agent (OpenRouter recommended — OpenAI-compatible):
#   AI_GATEWAY_API_KEY = your OpenRouter key (sk-or-...). The base URL is auto-detected
#   for sk-or- / vck_ keys; set AI_GATEWAY_BASE_URL only to override.
#   Then set the model in Settings → AI Agent to an OpenRouter id, e.g.
#   "openai/gpt-4o-mini" or "anthropic/claude-3.5-sonnet".
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_BASE_URL=
